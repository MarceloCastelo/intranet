# ============================================================
# Flask
# ============================================================
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
FLASK_ENV=production
FLASK_DEBUG=0

# ============================================================
# Banco de Dados
# ============================================================
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=portal_corporativo
MYSQL_USER=portal_user
MYSQL_PASSWORD=portal_password
DATABASE_URL=mysql+pymysql://portal_user:portal_password@db:3306/portal_corporativo

# ============================================================
# E-mail (SMTP)
# ============================================================
MAIL_SERVER=smtp.seudominio.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=noreply@seudominio.com
MAIL_PASSWORD=sua-senha-smtp
MAIL_DEFAULT_SENDER=Portal Corporativo <noreply@seudominio.com>

# ============================================================
# Segurança
# ============================================================
WTF_CSRF_SECRET_KEY=troque-por-outra-chave-csrf-aleatoria
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
PASSWORD_HISTORY_LIMIT=5
SESSION_LIFETIME_DAYS=7

# ============================================================
# Upload de Arquivos
# ============================================================
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp,pdf,doc,docx,xls,xlsx

# ============================================================
# Aplicação
# ============================================================
APP_NAME=Portal Corporativo
APP_URL=http://localhost
